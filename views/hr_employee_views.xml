<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Legacy HR mirror fields and a per-record "Sync from Legacy HR"
         button on the employee form.
         ================================================================ -->
    <record id="hr_employee_form_view_legacy_sync" model="ir.ui.view">
        <field name="name">hr.employee.form.legacy.sync</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="rental_management.hr_employee_inherit_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_code']" position="after">
                <field name="emp_company_code" readonly="1"
                       invisible="not emp_company_code"/>
                <field name="emp_dept_code" readonly="1"
                       invisible="not emp_dept_code"/>
                <field name="emp_dept_name" readonly="1"
                       invisible="not emp_dept_name"/>
                <field name="location_code" readonly="1"
                       invisible="not location_code"/>
                <field name="location_name" readonly="1"
                       invisible="not location_name"/>
                <field name="emp_grade" readonly="1"
                       invisible="not emp_grade"/>
                <field name="emp_designation" readonly="1"
                       invisible="not emp_designation"/>
                <field name="legacy_sync_status" readonly="1"
                       invisible="not legacy_sync_status"/>
                <field name="legacy_sync_date" readonly="1"
                       invisible="not legacy_sync_date"/>
                <field name="legacy_sync_message" readonly="1"
                       invisible="legacy_sync_status in ('synced', False)"/>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_form_button_legacy_sync" model="ir.ui.view">
        <field name="name">hr.employee.form.legacy.sync.button</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sync_from_legacy_hr"
                        type="object"
                        string="Sync from Legacy HR"
                        invisible="not employee_code"/>
            </xpath>
        </field>
    </record>

    <!-- Let people find employees the legacy system could not confirm. -->
    <record id="hr_employee_search_view_legacy_sync" model="ir.ui.view">
        <field name="name">hr.employee.search.legacy.sync</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="legacy_sync_not_found"
                        string="Not Found in Legacy HR"
                        domain="[('legacy_sync_status', '=', 'not_found')]"/>
                <filter name="legacy_sync_error"
                        string="Legacy HR Sync Failed"
                        domain="[('legacy_sync_status', '=', 'error')]"/>
            </xpath>
        </field>
    </record>
</odoo>
