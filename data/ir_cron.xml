<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ============================================================
             Daily reconciliation of Odoo employees against the legacy HR
             system. Gated by the Legacy HR Integration switch in
             Settings > Real Estate; a no-op while that is off.
             See models/hr_employee.py for the method.
             ============================================================ -->
        <record id="ir_cron_sync_legacy_employees" model="ir.cron">
            <field name="name">Legacy HR: Sync Employees</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_legacy_employees()</field>
        </record>
    </data>
</odoo>
